# ============================================================
# AuthDoc Node.js Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# Never commit .env to version control.
# ============================================================

# Server
PORT=3000

# Python OCR Service
PYTHON_OCR_URL=http://127.0.0.1:8000/extract

# Google Gemini AI Audit (optional — falls back to local heuristic)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# CORS — comma-separated allowed origins
CORS_ORIGINS=http://localhost:8080,http://localhost:3001

# File upload limits
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_BATCH=10
