# ============================================================
# AuthDoc Python OCR Service — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in the values.
# Never commit .env to version control.
# ============================================================

# Server
PORT=8000
HOST=127.0.0.1

# Tesseract OCR binary path (adjust for your OS)
TESSERACT_CMD=D:\products\AuthDoc\tesseract\tesseract.exe

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
